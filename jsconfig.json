{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"],
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noImplicitAny": false
  },
  "include": ["scripts/**/*.mjs", "examples/**/*.mjs", "test/**/*.mjs"],
  "exclude": ["node_modules"]
}
