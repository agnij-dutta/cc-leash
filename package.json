{
  "name": "cc-leash",
  "version": "0.1.0",
  "private": true,
  "description": "Spending limits for Claude Code: a plugin that enforces per-call, per-session and daily caps on MCP tool calls that move money.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mcp",
    "hooks",
    "spending-limits",
    "payments",
    "agent-safety",
    "x402",
    "stripe",
    "paypal"
  ],
  "homepage": "https://github.com/agnij-dutta/cc-leash#readme",
  "bugs": {
    "url": "https://github.com/agnij-dutta/cc-leash/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnij-dutta/cc-leash.git"
  },
  "license": "MIT",
  "author": "Agnij Dutta (https://x.com/0xholmesdev)",
  "type": "module",
  "bin": {
    "cc-leash": "scripts/leash.mjs"
  },
  "files": [
    ".claude-plugin/",
    "commands/",
    "hooks/",
    "scripts/",
    "examples/",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "validate": "claude plugin validate . && claude plugin validate .claude-plugin/plugin.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "demo": "bash examples/demo/demo.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
